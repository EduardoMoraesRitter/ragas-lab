# Copie para .env e preencha. O .env não vai para o git.
# Qualquer API compatível com OpenAI serve. Aqui: Gemini pelo endpoint OpenAI do Google (nível gratuito).
OPENAI_API_KEY=sua-chave-aqui
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
# Pausa em segundos entre chamadas, para caber no limite por minuto
PAUSA_S=2
